# ── LLM Provider ──────────────────────────────────────────
# Set to "gemini" (free) or "openai" (paid)
LLM_PROVIDER=gemini

# ── Gemini (Google AI Studio — FREE) ──────────────────────
# Get your key at: https://aistudio.google.com → "Get API Key"
GEMINI_API_KEY=your-gemini-api-key-here

# ── OpenAI (only needed if LLM_PROVIDER=openai) ───────────
OPENAI_API_KEY=your-openai-api-key-here

# ── MongoDB ────────────────────────────────────────────────
# Get from MongoDB Atlas → Connect → Drivers → copy connection string
MONGODB_URI=mongodb+srv://your-atlas-connection-string

# ── Server ─────────────────────────────────────────────────
PORT=3000
